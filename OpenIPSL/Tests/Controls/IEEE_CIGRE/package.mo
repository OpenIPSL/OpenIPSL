within OpenIPSL.Tests.Controls;
package IEEE_CIGRE "Set of simple systems to test the real-code (IEEE/CIGRE DLL) controller models"
  extends Modelica.Icons.ExamplesPackage;

  annotation (Documentation(info="<html>
<p>
Test systems for the models of
<a href=\"modelica://OpenIPSL.Electrical.Controls.IEEE_CIGRE\">Electrical.Controls.IEEE_CIGRE</a>. Read the
<a href=\"modelica://OpenIPSL.Tests.Controls.IEEE_CIGRE.README\">README</a> first: it says how to run each test in
Dymola, OpenModelica and Wolfram System Modeler, with which solver and step, what to plot, and which figure of the
papers each test reproduces.
</p>
</html>"));
end IEEE_CIGRE;
