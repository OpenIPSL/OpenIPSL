within OpenIPSL.Tests.Controls.IEEE_CIGRE;
package SCRX9 "Tests of the SCRX9 exciter computed by the IEEE/CIGRE DLL"
  extends Modelica.Icons.ExamplesPackage;

  annotation (Documentation(info="<html>
<p>
<a href=\"modelica://OpenIPSL.Tests.Controls.IEEE_CIGRE.SCRX9.SCRX9\">SCRX9</a> runs the DLL exciter on the SMIB test
system of the PSS/E exciter tests; <a href=\"modelica://OpenIPSL.Tests.Controls.IEEE_CIGRE.SCRX9.SCRX9_vs_SCRX\">SCRX9_vs_SCRX</a>
runs it next to the native <a href=\"modelica://OpenIPSL.Electrical.Controls.PSSE.ES.SCRX\">PSSE.ES.SCRX</a> on two
copies of the same system, for the comparison figure. See the
<a href=\"modelica://OpenIPSL.Tests.Controls.IEEE_CIGRE.README\">README</a> for the run settings.
</p>
</html>"));
end SCRX9;
