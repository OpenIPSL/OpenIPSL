// ============================================================================
//  Plot script  :  GFM_EMTPFull_Mod_TF_Test
//  Model        :  OpenIPSL.Tests.Controls.IEEE_CIGRE.GFM.GFM_EMTPFull_Mod_TF_Test
//  Category     :  SHORT-CIRCUIT (smooth short, zero-sequence transformer)
//
//  Topology     :  IBR -- EMTPtransformerZeroSeq -- SmoothShortFault -- EMTPGrid.
//  Events
//    * P_ref step 0.5 -> 0.7 pu at t = 2 s   (secondary, not in plot window)
//    * Smooth three-phase short (R=5 ohm) at t = 3.0 s, cleared at 3.1 s
//      (SmoothShortFault: faultTime=3, faultDuration=0.1).   Q_ref = 0.07 pu.
//
//  Plot window  :  centred on the short at t = 3 s. 1 cycle = 0.016667 s.
//
//  Signals (IBR instance "gFM_GFL_IBR")
//    Voltage [V] : grid_sensor_{a,b,c}.voltage   Current [A] : grid_sensor_{a,b,c}.current
//    P [MW] : out[11]                            Q [Mvar]    : out[12]
//
//  Tool: Dymola.   Run with:  RunScript("plot_GFM_EMTPFull_Mod_TF_Test.mos");
//        range = {x_min, x_max, y_max, y_min}.
// ============================================================================

simulateModel("OpenIPSL.Tests.Controls.IEEE_CIGRE.GFM.GFM_EMTPFull_Mod_TF_Test",
  stopTime=4.0, outputInterval=1e-4,
  method="Euler", fixedstepsize=1e-5,
  resultFile="GFM_EMTPFull_Mod_TF_Test");

// --- Figure 1 : phase voltages [V] ---
createPlot(id=1, erase=true, autoscale=false, grid=true,
  heading="GFM_EMTPFull_Mod_TF_Test: phase voltages (smooth short @ 3 s)",
  y={"gFM_GFL_IBR.grid_sensor_a.voltage","gFM_GFL_IBR.grid_sensor_b.voltage","gFM_GFL_IBR.grid_sensor_c.voltage"},
  legends={"v_a [V]","v_b [V]","v_c [V]"},
  range={2.98, 3.30, 7500, -7500});

// --- Figure 2 : phase currents [A] ---
createPlot(id=2, erase=true, autoscale=false, grid=true,
  heading="GFM_EMTPFull_Mod_TF_Test: phase currents",
  y={"gFM_GFL_IBR.grid_sensor_a.current","gFM_GFL_IBR.grid_sensor_b.current","gFM_GFL_IBR.grid_sensor_c.current"},
  legends={"i_a [A]","i_b [A]","i_c [A]"},
  range={2.98, 3.30, 4000, -4000});

// --- Figure 3 : active power P [MW] ---
createPlot(id=3, erase=true, autoscale=false, grid=true,
  heading="GFM_EMTPFull_Mod_TF_Test: active power P",
  y={"gFM_GFL_IBR.out[11]"},
  legends={"P [MW]"},
  range={2.95, 3.80, 12, -4});

// --- Figure 4 : reactive power Q [Mvar] ---
createPlot(id=4, erase=true, autoscale=false, grid=true,
  heading="GFM_EMTPFull_Mod_TF_Test: reactive power Q",
  y={"gFM_GFL_IBR.out[12]"},
  legends={"Q [Mvar]"},
  range={2.95, 3.80, 10, -10});
