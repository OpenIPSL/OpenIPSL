// ============================================================================
//  Plot script  :  GFM_Transformer
//  Model        :  OpenIPSL.Tests.Controls.IEEE_CIGRE.GFM.GFM_Transformer
//  Category     :  VOLTAGE-DIP (deep grid fault, through step-up transformer)
//
//  Topology     :  IBR (6.5 kV LV) -- ideal transformer (n=1/35.38) -- 230 kV grid.
//  Events       :  Grid voltage dip to 0.40 pu at t = 5.0 s, cleared at 5.1 s
//                  (GridWithFault: Vbase=230 kV, FaultVoltage=0.4, FaultTime=5,
//                   FaultDuration=0.1). The dip propagates to the LV terminal.
//                  (P_ref step is at t=10 s and never occurs in this window.)
//
//  Plot window  :  centred on the dip. 1 cycle = 0.016667 s. The plotted
//                  signals are measured at the IBR LV terminal (~6.5 kV base).
//
//  Signals (IBR instance "gFM_GFL_IBR")
//    Voltage [V] : grid_sensor_{a,b,c}.voltage   Current [A] : grid_sensor_{a,b,c}.current
//    P [MW] : out[11]                            Q [Mvar]    : out[12]
//
//  Tool: Dymola.   Run with:  RunScript("plot_GFM_Transformer.mos");
//        range = {x_min, x_max, y_max, y_min}.
// ============================================================================

simulateModel("OpenIPSL.Tests.Controls.IEEE_CIGRE.GFM.GFM_Transformer",
  stopTime=5.9, outputInterval=1e-4,
  method="Euler", fixedstepsize=1e-5,
  resultFile="GFM_Transformer");

// --- Figure 1 : phase voltages [V] (LV terminal) ---
createPlot(id=1, erase=true, autoscale=false, grid=true,
  heading="GFM_Transformer: LV phase voltages (0.4 pu dip @ 5 s)",
  y={"gFM_GFL_IBR.grid_sensor_a.voltage","gFM_GFL_IBR.grid_sensor_b.voltage","gFM_GFL_IBR.grid_sensor_c.voltage"},
  legends={"v_a [V]","v_b [V]","v_c [V]"},
  range={4.98, 5.25, 7500, -7500});

// --- Figure 2 : phase currents [A] (LV terminal) ---
createPlot(id=2, erase=true, autoscale=false, grid=true,
  heading="GFM_Transformer: LV phase currents",
  y={"gFM_GFL_IBR.grid_sensor_a.current","gFM_GFL_IBR.grid_sensor_b.current","gFM_GFL_IBR.grid_sensor_c.current"},
  legends={"i_a [A]","i_b [A]","i_c [A]"},
  range={4.98, 5.25, 4000, -4000});

// --- Figure 3 : active power P [MW] ---
createPlot(id=3, erase=true, autoscale=false, grid=true,
  heading="GFM_Transformer: active power P",
  y={"gFM_GFL_IBR.out[11]"},
  legends={"P [MW]"},
  range={4.95, 5.70, 12, -4});

// --- Figure 4 : reactive power Q [Mvar] ---
createPlot(id=4, erase=true, autoscale=false, grid=true,
  heading="GFM_Transformer: reactive power Q",
  y={"gFM_GFL_IBR.out[12]"},
  legends={"Q [Mvar]"},
  range={4.95, 5.70, 10, -10});
